# Copy to .env and fill in. Never commit .env.

# AI Incident Commander (optional; the game uses canned lines without it)
OPENAI_API_KEY=
OPENAI_MODEL=
# How long the server waits for the AI before giving up (ms)
AI_TIMEOUT_MS=3000

PORT=3000

# Set when phones reach the laptop through a tunnel or a different address,
# e.g. https://router-rumble.trycloudflare.com  (no trailing slash, no /play)
PUBLIC_URL=
